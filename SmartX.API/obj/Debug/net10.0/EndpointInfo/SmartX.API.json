{
  "openapi": "3.1.1",
  "info": {
    "title": "SmartX.API | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7231"
    },
    {
      "url": "http://localhost:5042"
    }
  ],
  "paths": {
    "/api/devices/register": {
      "post": {
        "tags": [
          "SmartX.API"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SensorDevice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SensorDevice"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "get": {
        "tags": [
          "SmartX.API"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SensorDevice"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/{macAddress}": {
      "get": {
        "tags": [
          "SmartX.API"
        ],
        "parameters": [
          {
            "name": "macAddress",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SensorDevice"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/devices/{macAddress}/readings": {
      "get": {
        "tags": [
          "SmartX.API"
        ],
        "parameters": [
          {
            "name": "macAddress",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SensorReading"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/{macAddress}/upload": {
      "post": {
        "tags": [
          "SmartX.API"
        ],
        "parameters": [
          {
            "name": "macAddress",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/telemetry/float": {
      "post": {
        "tags": [
          "SmartX.API"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryPacketOffloat"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnonymousTypeOfstringAndfloat"
                }
              }
            }
          }
        }
      }
    },
    "/api/telemetry/int": {
      "post": {
        "tags": [
          "SmartX.API"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryPacketOfint"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnonymousTypeOfstringAndint"
                }
              }
            }
          }
        }
      }
    },
    "/api/telemetry/bool": {
      "post": {
        "tags": [
          "SmartX.API"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryPacketOfboolean"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnonymousTypeOfstringAndboolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnonymousTypeOfstringAndboolean": {
        "required": [
          "status",
          "value"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "value": {
            "type": "boolean"
          }
        }
      },
      "AnonymousTypeOfstringAndfloat": {
        "required": [
          "status",
          "value"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float"
          }
        }
      },
      "AnonymousTypeOfstringAndint": {
        "required": [
          "status",
          "value"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "SensorCategory": {
        "type": "integer"
      },
      "SensorDevice": {
        "type": "object",
        "properties": {
          "macAddress": {
            "type": "string"
          },
          "deploymentLocation": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/SensorCategory"
          },
          "isActive": {
            "type": "boolean"
          },
          "registeredAt": {
            "type": "string",
            "format": "date-time"
          },
          "configurationFilePath": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SensorReading": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "TelemetryPacketOfboolean": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "type": "boolean"
          },
          "unit": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/SensorCategory"
          }
        }
      },
      "TelemetryPacketOffloat": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "float"
          },
          "unit": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/SensorCategory"
          }
        }
      },
      "TelemetryPacketOfint": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unit": {
            "type": "string"
          },
          "category": {
            "$ref": "#/components/schemas/SensorCategory"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "SmartX.API"
    }
  ]
}