[Bb]in/
[Oo]bj/
[Oo]ut/
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml

# Rider / VS Code
.idea/
.vscode/*

# macOS
.DS_Store

# Publish output
publish/
*.publishsettings

# Docker / local overrides
docker-compose.override.yml

# Local run artefacts (dotnet run output captured during testing)
*.log
*.err
*.pid
